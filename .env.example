# ---------------------------------------------------------------------------
# Lead Finder — environment configuration
#
# Copy this file to `.env` and fill in your keys:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Google (required) -----------------------------------------------------
# Enable these APIs in Google Cloud Console for the project that owns the key:
#   * Places API           (legacy)  -- or "Places API (New)" if using v1
#   * Geocoding API                  -- used to resolve "City, State, Country"
#   * PageSpeed Insights API         -- optional but recommended
#
# A single key can serve all three. If you prefer separate keys, set them below.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Optional: separate key for PageSpeed Insights. Falls back to
# GOOGLE_MAPS_API_KEY when unset. PSI also works key-less at a very low quota.
PAGESPEED_API_KEY=

# Which Places API to talk to: "legacy" (maps.googleapis.com, supports
# next_page_token pagination) or "v1" (places.googleapis.com, the New Places API).
GOOGLE_PLACES_API_VERSION=legacy


# --- Anthropic (optional) --------------------------------------------------
# Enables AI-written lead reasoning, cold emails and LinkedIn messages.
# Without it the app still produces all of those from deterministic templates.
ANTHROPIC_API_KEY=

# Model used for lead summaries. Defaults to claude-opus-5.
LEAD_FINDER_AI_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
# "low" is plenty for short outreach copy and keeps cost/latency down.
LEAD_FINDER_AI_EFFORT=low


# --- Runtime tuning (optional) ---------------------------------------------
# All of these are also settable in config.yaml / on the command line.
LEAD_FINDER_LOG_LEVEL=INFO
LEAD_FINDER_OUTPUT_DIR=output
LEAD_FINDER_CACHE_DIR=.cache
LEAD_FINDER_CACHE_ENABLED=true

# Politeness: identify your crawler to the sites you audit.
LEAD_FINDER_USER_AGENT=LeadFinderBot/1.0 (+https://example.com/bot; contact@example.com)
